{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pickled-spec functionality inventory",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repo_root",
    "totals",
    "packages",
    "adrs",
    "workspaces",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "repo_root": { "type": "string" },
    "totals": {
      "type": "object",
      "required": [
        "packages",
        "cli_commands",
        "mcp_tools",
        "gates",
        "adrs",
        "workspaces"
      ],
      "properties": {
        "packages": { "type": "integer" },
        "cli_commands": { "type": "integer" },
        "mcp_tools": { "type": "integer" },
        "gates": { "type": "integer" },
        "adrs": { "type": "integer" },
        "workspaces": { "type": "integer" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "description": { "type": "string" },
          "scripts": { "type": "object" },
          "entry_points": { "type": "object" },
          "optional_dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cli_commands": { "type": "array" },
          "mcp_tools": { "type": "array" },
          "gates": { "type": "array" }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "date": { "type": "string" },
          "file": { "type": "string" },
          "supersedes": { "type": "array", "items": { "type": "string" } },
          "superseded_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "config_file": { "type": "string" },
          "form": { "type": "string" },
          "rulesets": { "type": "array" },
          "feature_count": { "type": "integer" },
          "story_count": { "type": "integer" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
